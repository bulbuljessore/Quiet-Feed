{
  "manifest_version": 3,
  "name": "Quiet Feed – Keyword & Channel Filter",
  "version": "1.2.0",
  "description": "আপনার দেওয়া নাম বা কীওয়ার্ড যে পোস্ট, কমেন্ট বা লেখায় আছে, সেগুলো সোশ্যাল মিডিয়া ও ব্লগে লুকিয়ে রাখে। Hide posts and comments that mention names or keywords you choose.",
  "browser_specific_settings": {
    "gecko": {
      "id": "{a6516c22-e157-4cb5-ad6e-afda670af748}",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Quiet Feed",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "permissions": [
    "storage",
    "declarativeNetRequest",
    "alarms"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "scripts": [
      "vendor/tesseract.min.js",
      "safesearch.js",
      "updatecheck.js",
      "background.js"
    ]
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "adult-terms.js",
        "adult.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "blur.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": [
        "https://*.youtube.com/*"
      ],
      "js": [
        "adult-terms.js",
        "youtube.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "adult-terms.js",
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
